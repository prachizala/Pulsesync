# Application Settings
PROJECT_NAME="PulseSync Emergency Dispatch"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
SECRET_KEY="generate-a-secure-random-secret-key-for-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Settings (PostgreSQL for Docker/Production, SQLite async for tests)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pulsesync
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pulsesync

# Redis Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# CORS
BACKEND_CORS_ORIGINS=["http://localhost", "http://localhost:3000", "http://localhost:8080", "*"]
